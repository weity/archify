{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tt-a1i/archify/schemas/atlas.schema.json",
  "title": "Archify Atlas Manifest",
  "description": "Defines a navigable collection of Archify diagrams with hierarchical drill-down relationships",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "atlas_type", "meta", "diagrams"],
  "properties": {
    "schema_version": { "const": 1 },
    "atlas_type": { "const": "atlas" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "entry"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable title of the atlas"
        },
        "locale": { "$ref": "common.schema.json#/$defs/locale" },
        "description": {
          "type": "string",
          "description": "Brief description of the atlas scope and purpose"
        },
        "entry": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
          "description": "ID of the entry-point diagram (L0 system overview)"
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "revision"],
          "properties": {
            "url": { "type": "string", "minLength": 1 },
            "provider": { "enum": ["github", "gitee"] },
            "revision": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" }
          }
        }
      }
    },
    "diagrams": {
      "type": "array",
      "minItems": 1,
      "description": "All diagrams in the atlas, ordered by hierarchy level",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "level", "title", "path"],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id",
            "description": "Stable identifier; should match the node ID in parent diagrams"
          },
          "type": {
            "enum": ["architecture", "workflow", "sequence", "dataflow", "lifecycle"],
            "description": "Archify diagram type"
          },
          "level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9,
            "description": "Hierarchy level: L0=system, L1=module, L2=business, L3=interaction, L4=API, L5=data"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable diagram title"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Relative path from atlas root to the diagram HTML file"
          },
          "source_path": {
            "type": "string",
            "description": "Relative path to the JSON source file"
          },
          "parent": {
            "$ref": "common.schema.json#/$defs/id",
            "description": "ID of the parent diagram (null/omitted for L0 entry)"
          },
          "parent_node": {
            "$ref": "common.schema.json#/$defs/id",
            "description": "Node ID in the parent diagram that drills down to this diagram"
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Searchable tags for filtering and navigation"
          },
          "summary": {
            "type": "string",
            "maxLength": 200,
            "description": "Brief description shown in navigation"
          }
        }
      }
    },
    "levels": {
      "type": "object",
      "description": "Level definitions for the atlas hierarchy",
      "additionalProperties": false,
      "properties": {
        "L0": { "$ref": "#/$defs/levelDefinition" },
        "L1": { "$ref": "#/$defs/levelDefinition" },
        "L2": { "$ref": "#/$defs/levelDefinition" },
        "L3": { "$ref": "#/$defs/levelDefinition" },
        "L4": { "$ref": "#/$defs/levelDefinition" },
        "L5": { "$ref": "#/$defs/levelDefinition" },
        "L6": { "$ref": "#/$defs/levelDefinition" },
        "L7": { "$ref": "#/$defs/levelDefinition" },
        "L8": { "$ref": "#/$defs/levelDefinition" },
        "L9": { "$ref": "#/$defs/levelDefinition" }
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "breadcrumb_template": {
          "type": "string",
          "description": "Template for breadcrumb display"
        },
        "show_siblings": {
          "type": "boolean",
          "default": true,
          "description": "Whether to show sibling diagrams at the same level"
        }
      }
    }
  },
  "$defs": {
    "levelDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "preferred_types": {
          "type": "array",
          "items": { "enum": ["architecture", "workflow", "sequence", "dataflow", "lifecycle"] }
        }
      }
    }
  }
}
